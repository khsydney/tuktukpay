# ---- Splunk Observability Cloud (required) --------------------------------
SPLUNK_REALM=au0                      # e.g. us1, eu0, au0, jp0, sg0 (Org settings > General)
SPLUNK_ACCESS_TOKEN=REPLACE_ME        # an INGEST token (Settings > Access Tokens)

# Each team gets its own environment so the APM environment filter isolates them.
DEPLOYMENT_ENVIRONMENT=tuktukpay-team01
SERVICE_VERSION=2026.09.1

# ---- Logs: Splunk Cloud Platform via HEC + Log Observer Connect (docs/logs-setup.md)
# Splunk Cloud on AWS: https://http-inputs-<stack>.splunkcloud.com:443/services/collector
# Splunk Cloud on GCP: https://http-inputs.<stack>.splunkcloud.com:443/services/collector
# The HEC token must have indexer acknowledgement OFF and your public IP must be on the
# stack's "HEC access for ingestion" allow list. Leave unset to fall back to the O11y
# ingest endpoint (only works with the Observability Logs entitlement).
# SPLUNK_HEC_URL=https://http-inputs-<stack>.splunkcloud.com:443/services/collector
# SPLUNK_HEC_TOKEN=REPLACE_ME
# SPLUNK_HEC_INDEX=tuktukpay
# LOG_LEVEL=INFO                        # DEBUG shows every per-request event (noisy)

# ---- Traffic -----------------------------------------------------------------
BASE_RPS=4                            # requests/second at multiplier 1 (festival spike multiplies this)
COPILOT_INTERVAL_S=8                  # seconds between copilot questions

# ---- Agentic checkout (Act 4): shopping agent + wallet-sim ---------------------
# LLM behind the shopping agent: mock (default) | openai | anthropic | bedrock
AGENT_PROVIDER=mock
AGENT_MODEL=
AGENT_GUARDRAIL=flag                  # flag = log untrusted catalog content; strict = drop it before the model sees it
AMP_SHARED_SECRET=tuktukpay-amp-demo-secret   # wallet <-> acquirer token key (demo)

# ---- Merchant copilot LLM ----------------------------------------------------
# mock (default, no keys needed) | openai | anthropic | bedrock
COPILOT_PROVIDER=mock
# Model id for the chosen provider, e.g. gpt-4o-mini / claude-haiku-4-5 / amazon.nova-lite-v1:0
# (keep comments on their own line: Compose keeps a trailing "# ..." when the value is empty)
COPILOT_MODEL=
COPILOT_GUARDRAIL=on                  # off -> the injected refund goes through (for the "before" demo)
COPILOT_CAPTURE_CONTENT=false         # true -> prompts/responses on spans (PII caution!)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_REGION=ap-southeast-1

# ---- Dual-ship to Datadog during the evaluation (docker-compose.dualship.yml) --
# DD_API_KEY=
# DD_SITE=datadoghq.com               # or ap1.datadoghq.com etc.
